#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# SwitchMoney backend — dépendances installées par npm (Render fait son
# propre `npm install` sur Linux ; les binaires natifs commités ici sont
# compilés pour Windows et planteraient sur le serveur)
backend/node_modules/

# SwitchMoney backend — secrets (jamais commités ; configurés dans Render)
backend/.env

# SwitchMoney backend — bases de données runtime (comptes, transactions,
# bénéficiaires) : régénérées au démarrage, jamais commitées
backend/switchmoney.db
backend/switchmoney.db-shm
backend/switchmoney.db-wal
backend/recipients.db
backend/recipients.db-shm
backend/recipients.db-wal
.neon
.env.local

# Signature de production Android — ne doit jamais entrer dans le depot.
android/key.properties
android/*.p12
android/*.jks
