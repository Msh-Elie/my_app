# Environment template - copy to .env and update values

# PawaPay Integration
PAWA_TOKEN=your_pawa_token_here
PAWA_BASE=https://api.sandbox.pawapay.io/v2
CALLBACK_URL=https://your-domain.com/pawapay/callback
CALLBACK_SECRET=your_callback_secret
BACKEND_BASE=https://your-domain.com

# Server
PORT=3000

# Authentification SwitchMoney — générez une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate_a_long_random_secret
# Durée de vie des jetons de session (secondes, défaut 30 jours)
#AUTH_TOKEN_TTL_SECONDS=2592000

# Endpoint de test /api/simulate-callback (laisser false hors sandbox)
ENABLE_SIMULATE=false
# Exiger une signature HMAC (CALLBACK_SECRET) sur /pawapay/callback
VERIFY_CALLBACK_SIGNATURE=false

# Recipient Lookup — la base de bénéficiaires est fusionnée dans ce
# process (backend/recipient_lookup.js) : aucune config nécessaire.
# RECIPIENT_LOOKUP_URL reste disponible pour brancher une VRAIE API externe
# (KYC opérateur) en plus de la base locale ; laissez vide sinon.
RECIPIENT_LOOKUP_URL=
RECIPIENT_LOOKUP_TOKEN=
# Port de l'outil admin autonome (recipient_lookup_service_db.js), usage
# local uniquement — jamais déployé publiquement.
RECIPIENT_LOOKUP_PORT=3003

# MTN MoMo-like Recipient Name Lookup (optional, priority for MTN providers)
MTN_MOMO_LOOKUP_URL=
MTN_MOMO_LOOKUP_TOKEN=
RECIPIENT_LOOKUP_TIMEOUT_MS=6000
